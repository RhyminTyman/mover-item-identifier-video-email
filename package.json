    "openai": "^4.58.1",
    "pdfkit": "^0.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "svix": "^1.76.1",
    "swr": "^2.2.5",
    "zod": "^3.23.8"
