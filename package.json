{
  "name": "mover-item-identifier",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "setup:neon": "node scripts/setup-neon.js",
    "setup:redis": "node scripts/setup-redis.js",
    "migrate:neon": "node scripts/prisma-migrate-to-neon.js",
    "migrate:data": "node scripts/migrate-to-neon.js",
    "health:neon": "curl http://localhost:3000/api/health/neon",
    "health:redis": "curl http://localhost:3000/api/health/redis",
    "test:redis": "curl -s http://localhost:3000/api/health/redis | jq .",
    "redis:ping": "curl -s http://localhost:3000/api/health/redis",
    "tsc": "tsc --noEmit",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:e2e",
    "test:unit": "jest",
    "playwright:install": "playwright install",
    "playwright:install-deps": "playwright install-deps"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@clerk/nextjs": "^6.31.10",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@ittybit/sdk": "^1.0.0",
    "@mui/icons-material": "^6.1.4",
    "@mui/material": "^6.1.4",
    "@neondatabase/serverless": "^1.0.1",
    "@prisma/client": "6.16.1",
    "@types/formidable": "^3.4.5",
    "@upstash/redis": "^1.34.3",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "form-data": "^4.0.4",
    "formidable": "^3.5.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "lucide-react": "^0.542.0",
    "next": "15.5.2",
    "nodemailer": "^6.9.14",
    "openai": "^4.58.1",
    "pdfkit": "^0.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.0.3",
    "svix": "^1.76.1",
    "swr": "^2.2.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^18.2.68",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.2",
    "iconv-lite": "^0.7.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "prisma": "^6.16.1",
    "ts-jest": "^29.4.1",
    "typescript": "^5.5.4"
  }
}