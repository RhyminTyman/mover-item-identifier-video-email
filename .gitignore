# Environment variables
# Ignore every .env* file, then re-allow the committed templates. The previous
# explicit list missed .env.backup / .env.local.backup / .env.temp / .env.vercel,
# all of which were committed with live credentials.
.env
.env.*
!.env.example
!.env.local.example

# Server logs
server.log
*.log

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

