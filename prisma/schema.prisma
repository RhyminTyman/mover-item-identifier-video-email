generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String
  lastName  String
  role      String   @default("customer") // customer, sales, admin, company-admin
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Company relations
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  // Relations
  inventories     Inventory[] @relation("CustomerInventories")
  salesInventories Inventory[] @relation("SalesInventories")
  assignedInventories Inventory[] @relation("AssignedSalesRep")
  
  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([companyId])
}

// Company Management
model Company {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  phone       String?
  email       String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Pricing settings
  baseCostPerHour     Float    @default(50.0)
  costPerMile         Float    @default(2.0)
  costPerCubicFoot    Float    @default(0.5)
  costPerPound        Float    @default(0.1)
  stairCostPerFlight  Float    @default(10.0)
  packingCostPerBox   Float    @default(5.0)
  unpackingCostPerBox Float    @default(3.0)
  disposalCost        Float    @default(25.0)
  storageCostPerDay   Float    @default(10.0)
  rushServiceMultiplier Float  @default(1.5)
  taxRate             Float    @default(8.0)
  
  // Relations
  users       User[]
  inventories Inventory[]
  
  @@index([name])
}

// Customer Information
model CustomerInfo {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  inventories Inventory[]
  
  @@index([email])
  @@index([firstName, lastName])
}

model Inventory {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  title       String   @default("Untitled")
  note        String   @default("")
  photos      Photo[]
  items       Item[]
  
  // Workflow status tracking
  status      String   @default("submitted") // submitted, assigned, verified, quoted, accepted, rejected
  assignedSalesRepId String?  // Sales rep assigned to this inventory
  assignedSalesRep   User?    @relation("AssignedSalesRep", fields: [assignedSalesRepId], references: [id], onDelete: SetNull)
  assignedAt         DateTime? // When the inventory was assigned to a sales rep
  verifiedAt         DateTime? // When the sales rep completed verification
  quotedAt           DateTime? // When the final quote was provided
  acceptedAt         DateTime? // When the customer accepted the quote
  
  // User relations
  userId      String?  // Customer who owns the inventory
  user        User?    @relation("CustomerInventories", fields: [userId], references: [id], onDelete: Cascade)
  salesUserId String?  // Sales person who created/manages the inventory
  salesUser   User?    @relation("SalesInventories", fields: [salesUserId], references: [id], onDelete: SetNull)
  
  // Company and customer info relations
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customerInfoId String?
  customerInfo CustomerInfo? @relation(fields: [customerInfoId], references: [id], onDelete: SetNull)
  
  // Pricing calculation data
  moveDate        DateTime?
  originAddress   String?
  destinationAddress String?
  distance        Float?
  accessType      String? // Ground Floor, Elevator, Stairs, Other
  stairFlights    Int?
  rushService     Boolean @default(false)
  sameBuilding    Boolean @default(false)
  packingBoxes    Int @default(0)
  unpackingBoxes  Int @default(0)
  disposalNeeded  Boolean @default(false)
  storageNeeded   Boolean @default(false)
  
  // Calculated pricing
  totalCubicFeet  Float?
  totalWeight     Float?
  estimatedHours  Float?
  baseCost        Float?
  additionalHandling Float?
  disposalCost    Float?
  storageCost     Float?
  stairsCost      Float?
  packingCost     Float?
  unpackingCost   Float?
  distanceCost    Float?
  subtotal        Float?
  taxAmount       Float?
  totalCost       Float?
  
  @@index([userId])
  @@index([salesUserId])
  @@index([companyId])
  @@index([customerInfoId])
  @@index([status])
  @@index([assignedSalesRepId])
}

model Photo {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  filename    String
  mimeType    String
  url         String
  key         String
  bucket      String
  roomName    String?
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId String

  @@index([inventoryId])
}

model Item {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  shortName   String
  description String
  notes       String    @default("")
  lengthIn    Float?
  widthIn     Float?
  heightIn    Float?
  tags        String[]
  roomName    String?
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId String

  @@index([inventoryId])
}

// Analytics Tables
model AnalysisSession {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  sessionId         String   @unique
  userId            String?  // Optional user identification
  totalImages       Int
  totalVideos       Int
  totalFiles        Int
  analysisDuration  Int?     // Duration in milliseconds
  aiModel           String   @default("gpt-4o-mini")
  confidenceScore   Float?   // Overall confidence score
  totalItemsFound   Int
  itemsEdited       Int      @default(0)
  significantEdits  Int      @default(0) // Items with >10% dimension changes
  feedbackSent      Boolean  @default(false)
  errorOccurred     Boolean  @default(false)
  errorMessage      String?
  
  // Relations
  itemAnalytics     ItemAnalytics[]
  feedbackSessions  FeedbackSession[]
  
  @@index([createdAt])
  @@index([sessionId])
}

model ItemAnalytics {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  sessionId         String
  analysisSession   AnalysisSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  
  // Item identification
  shortName         String
  description       String
  roomName          String?
  tags              String[]
  
  // AI predictions
  aiLength          Float?
  aiWidth           Float?
  aiHeight          Float?
  aiConfidence      Float?   // AI confidence for this specific item
  
  // User corrections
  userLength        Float?
  userWidth         Float?
  userHeight        Float?
  wasEdited         Boolean  @default(false)
  editTimestamp     DateTime?
  
  // Accuracy metrics
  lengthAccuracy    Float?   // Percentage accuracy
  widthAccuracy     Float?
  heightAccuracy    Float?
  overallAccuracy   Float?   // Average accuracy
  significantError  Boolean  @default(false) // >10% difference
  
  // Metadata
  processingTime    Int?     // Time to process this item in ms
  imageQuality      String?  // "high", "medium", "low"
  itemComplexity    String?  // "simple", "moderate", "complex"
  
  @@index([sessionId])
  @@index([createdAt])
  @@index([significantError])
}

model FeedbackSession {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  sessionId         String
  analysisSession   AnalysisSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  
  // Feedback data
  correctedItems    Int
  totalDifferences  Int
  averageDifference Float
  maxDifference     Float
  
  // AI learning data
  aiFeedback        String?  // AI's response to the feedback
  learningInsights  String?  // Key insights for improvement
  suggestedImprovements String? // AI suggestions
  
  // Feedback processing
  feedbackProcessed Boolean  @default(false)
  processingTime    Int?     // Time to process feedback in ms
  errorOccurred     Boolean  @default(false)
  errorMessage      String?
  
  @@index([sessionId])
  @@index([createdAt])
}

model SystemMetrics {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  
  // Daily metrics
  date              DateTime @unique
  totalSessions     Int      @default(0)
  totalImages       Int      @default(0)
  totalItems        Int      @default(0)
  totalEdits        Int      @default(0)
  totalFeedback     Int      @default(0)
  
  // Accuracy metrics
  averageAccuracy   Float?
  itemsWithErrors   Int      @default(0)
  significantErrors Int      @default(0)
  
  // Performance metrics
  averageProcessingTime Float?
  averageAnalysisTime   Float?
  errorRate             Float?
  
  // User behavior
  averageItemsPerSession Float?
  averageEditsPerSession Float?
  mostCommonRooms        String[]
  mostCommonItemTypes    String[]
  
  @@index([date])
}
