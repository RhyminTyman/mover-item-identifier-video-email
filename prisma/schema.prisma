generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String
  lastName  String
  role      String   @default("customer") // customer, sales, admin, company-admin
  isActive  Boolean  @default(true)
  onboarded Boolean  @default(false) // Track if user has completed onboarding
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Company relations
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  // Relations
  inventories     Inventory[] @relation("CustomerInventories")
  salesInventories Inventory[] @relation("SalesInventories")
  assignedInventories Inventory[] @relation("AssignedSalesRep")
  addresses       Address[]
  
  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([companyId])
}

// Company Management
model Company {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  phone       String?
  email       String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Pricing settings
  baseCostPerHour     Float    @default(50.0)
  costPerMile         Float    @default(2.0)
  costPerCubicFoot    Float    @default(0.5)
  costPerPound        Float    @default(0.1)
  stairCostPerFlight  Float    @default(10.0)
  packingCostPerBox   Float    @default(5.0)
  unpackingCostPerBox Float    @default(3.0)
  disposalCost        Float    @default(25.0)
  storageCostPerDay   Float    @default(10.0)
  rushServiceMultiplier Float  @default(1.5)
  taxRate             Float    @default(8.0)
  
  // Relations
  users       User[]
  inventories Inventory[]
  crmIntegrations CrmIntegration[]
  
  @@index([name])
}

// Customer Information
model CustomerInfo {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  inventories Inventory[]
  
  @@index([email])
  @@index([firstName, lastName])
}

model Inventory {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  title       String   @default("Untitled")
  note        String   @default("")
  photos      Photo[]
  items       Item[]
  
  // Workflow status tracking
  status      String   @default("submitted") // submitted, assigned, verified, quoted, accepted, rejected
  assignedSalesRepId String?  // Sales rep assigned to this inventory
  assignedSalesRep   User?    @relation("AssignedSalesRep", fields: [assignedSalesRepId], references: [id], onDelete: SetNull)
  assignedAt         DateTime? // When the inventory was assigned to a sales rep
  verifiedAt         DateTime? // When the sales rep completed verification
  quotedAt           DateTime? // When the final quote was provided
  acceptedAt         DateTime? // When the customer accepted the quote
  
  // User relations
  userId      String?  // Customer who owns the inventory
  user        User?    @relation("CustomerInventories", fields: [userId], references: [id], onDelete: Cascade)
  salesUserId String?  // Sales person who created/manages the inventory
  salesUser   User?    @relation("SalesInventories", fields: [salesUserId], references: [id], onDelete: SetNull)
  
  // Company and customer info relations
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customerInfoId String?
  customerInfo CustomerInfo? @relation(fields: [customerInfoId], references: [id], onDelete: SetNull)
  
  // Address relations
  originAddressId String?
  originAddress   Address? @relation("OriginAddresses", fields: [originAddressId], references: [id], onDelete: SetNull)
  destinationAddressId String?
  destinationAddress Address? @relation("DestinationAddresses", fields: [destinationAddressId], references: [id], onDelete: SetNull)
  
  // Pricing calculation data
  moveDate        DateTime?
  distance        Float?
  accessType      String? // Ground Floor, Elevator, Stairs, Other
  stairFlights    Int?
  rushService     Boolean @default(false)
  sameBuilding    Boolean @default(false)
  packingBoxes    Int @default(0)
  unpackingBoxes  Int @default(0)
  disposalNeeded  Boolean @default(false)
  storageNeeded   Boolean @default(false)
  
  // Calculated pricing
  totalCubicFeet  Float?
  totalWeight     Float?
  estimatedHours  Float?
  baseCost        Float?
  additionalHandling Float?
  disposalCost    Float?
  storageCost     Float?
  stairsCost      Float?
  packingCost     Float?
  unpackingCost   Float?
  distanceCost    Float?
  subtotal        Float?
  taxAmount       Float?
  totalCost       Float?
  
  @@index([userId])
  @@index([salesUserId])
  @@index([companyId])
  @@index([customerInfoId])
  @@index([status])
  @@index([assignedSalesRepId])
}

// CRM Integration Management
model CrmIntegration {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // CRM Provider Information
  provider    String   // smartmoving, moveguru, movingwaldo, movecrm, motiontools, custom
  name        String   // Display name for the integration
  description String?  // Optional description
  
  // API Configuration
  apiEndpoint String?  // Base API endpoint
  apiKey      String?  // API key (encrypted)
  apiSecret   String?  // API secret (encrypted)
  webhookUrl  String?  // Webhook URL for real-time updates
  
  // Sync Configuration
  isActive    Boolean  @default(false)
  syncLeads   Boolean  @default(true)
  syncSales   Boolean  @default(true)
  syncSchedule Boolean @default(true)
  syncCustomers Boolean @default(true)
  lastSyncAt  DateTime?
  
  // Additional Settings (JSON)
  settings    Json?    // Provider-specific settings
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  crmLeads    CrmLead[]
  crmSales    CrmSale[]
  crmSchedules CrmSchedule[]
  
  @@index([companyId])
  @@index([provider])
  @@index([isActive])
}

// CRM Lead Management
model CrmLead {
  id              String   @id @default(cuid())
  integrationId   String
  integration     CrmIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  // Lead Information
  crmLeadId       String   // External CRM lead ID
  firstName       String
  lastName        String
  email           String?
  phone           String?
  company         String?
  
  // Lead Details
  source          String?  // Website, referral, ad, etc.
  status          String   @default("new") // new, contacted, qualified, unqualified, converted
  priority        String   @default("medium") // low, medium, high
  estimatedValue  Float?
  notes           String?
  
  // Moving Information
  moveDate        DateTime?
  originAddress   String?
  destinationAddress String?
  moveType        String? // residential, commercial, local, long-distance
  
  // Sync Information
  lastSyncedAt    DateTime?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  crmSales        CrmSale[]
  crmSchedules    CrmSchedule[]
  
  @@index([integrationId])
  @@index([crmLeadId])
  @@index([status])
  @@index([isActive])
}

// CRM Sales Management
model CrmSale {
  id              String   @id @default(cuid())
  integrationId   String
  integration     CrmIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  
  // Sale Information
  crmSaleId       String   // External CRM sale ID
  opportunityName String
  stage           String   // prospecting, qualification, proposal, negotiation, closed-won, closed-lost
  probability     Int?     // 0-100 percentage
  
  // Financial Information
  estimatedValue  Float?
  actualValue     Float?
  currency        String   @default("USD")
  
  // Dates
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  
  // Additional Information
  notes           String?
  
  // Sync Information
  lastSyncedAt    DateTime?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([integrationId])
  @@index([crmSaleId])
  @@index([stage])
  @@index([isActive])
}

// CRM Schedule Management
model CrmSchedule {
  id              String   @id @default(cuid())
  integrationId   String
  integration     CrmIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  
  // Schedule Information
  crmScheduleId   String   // External CRM schedule ID
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime?
  location        String?
  
  // Schedule Details
  type            String   // appointment, site-visit, follow-up, meeting
  status          String   @default("scheduled") // scheduled, completed, cancelled, rescheduled
  priority        String   @default("medium") // low, medium, high
  
  // Attendees
  attendees       Json?    // Array of attendee information
  
  // Sync Information
  lastSyncedAt    DateTime?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([integrationId])
  @@index([crmScheduleId])
  @@index([startTime])
  @@index([status])
  @@index([isActive])
}

model Photo {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  filename    String
  mimeType    String
  url         String
  key         String
  bucket      String
  roomName    String?
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId String

  @@index([inventoryId])
}

model Item {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  shortName   String
  description String
  notes       String    @default("")
  lengthIn    Float?
  widthIn     Float?
  heightIn    Float?
  count       Int       @default(1)
  tags        String[]
  roomName    String?
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId String

  @@index([inventoryId])
}

// Analytics Tables
model AnalysisSession {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  sessionId         String   @unique
  userId            String?  // Optional user identification
  totalImages       Int
  totalVideos       Int
  totalFiles        Int
  analysisDuration  Int?     // Duration in milliseconds
  aiModel           String   @default("gpt-4o-mini")
  confidenceScore   Float?   // Overall confidence score
  totalItemsFound   Int
  itemsEdited       Int      @default(0)
  significantEdits  Int      @default(0) // Items with >10% dimension changes
  feedbackSent      Boolean  @default(false)
  errorOccurred     Boolean  @default(false)
  errorMessage      String?
  analysisResult    String?  // JSON string of the analysis result
  
  // Relations
  itemAnalytics     ItemAnalytics[]
  feedbackSessions  FeedbackSession[]
  
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
}

model ItemAnalytics {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  sessionId         String
  analysisSession   AnalysisSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  
  // Item identification
  shortName         String
  description       String
  roomName          String?
  tags              String[]
  fileTags          String[]  // Tags from the uploaded file
  
  // AI predictions
  aiLength          Float?
  aiWidth           Float?
  aiHeight          Float?
  aiConfidence      Float?   // AI confidence for this specific item
  
  // User corrections
  userLength        Float?
  userWidth         Float?
  userHeight        Float?
  wasEdited         Boolean  @default(false)
  editTimestamp     DateTime?
  
  // Accuracy metrics
  lengthAccuracy    Float?   // Percentage accuracy
  widthAccuracy     Float?
  heightAccuracy    Float?
  overallAccuracy   Float?   // Average accuracy
  significantError  Boolean  @default(false) // >10% difference
  
  // Metadata
  processingTime    Int?     // Time to process this item in ms
  imageQuality      String?  // "high", "medium", "low"
  itemComplexity    String?  // "simple", "moderate", "complex"
  
  @@index([sessionId])
  @@index([createdAt])
  @@index([significantError])
}

model FeedbackSession {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  sessionId         String
  analysisSession   AnalysisSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  
  // Feedback data
  correctedItems    Int
  totalDifferences  Int
  averageDifference Float
  maxDifference     Float
  
  // AI learning data
  aiFeedback        String?  // AI's response to the feedback
  learningInsights  String?  // Key insights for improvement
  suggestedImprovements String? // AI suggestions
  
  // Feedback processing
  feedbackProcessed Boolean  @default(false)
  processingTime    Int?     // Time to process feedback in ms
  errorOccurred     Boolean  @default(false)
  errorMessage      String?
  
  @@index([sessionId])
  @@index([createdAt])
}

model SystemMetrics {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  
  // Daily metrics
  date              DateTime @unique
  totalSessions     Int      @default(0)
  totalImages       Int      @default(0)
  totalItems        Int      @default(0)
  totalEdits        Int      @default(0)
  totalFeedback     Int      @default(0)
  
  // Accuracy metrics
  averageAccuracy   Float?
  itemsWithErrors   Int      @default(0)
  significantErrors Int      @default(0)
  
  // Performance metrics
  averageProcessingTime Float?
  averageAnalysisTime   Float?
  errorRate             Float?
  
  // User behavior
  averageItemsPerSession Float?
  averageEditsPerSession Float?
  mostCommonRooms        String[]
  mostCommonItemTypes    String[]
  
  @@index([date])
}

// State Management
model State {
  id        String   @id @default(cuid())
  code      String   @unique // e.g., "CA", "NY", "TX"
  name      String   @unique // e.g., "California", "New York", "Texas"
  type      String   @default("state") // state, territory, military
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  addresses Address[]
  
  @@index([code])
  @@index([name])
  @@index([type])
  @@index([isActive])
}

// Address Management
model Address {
  id        String   @id @default(cuid())
  street1   String
  street2   String?
  city      String
  stateId   String
  zipCode   String
  country   String   @default("US")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  state State @relation(fields: [stateId], references: [id], onDelete: Restrict)
  
  // User relations
  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Inventory relations
  inventories Inventory[] @relation("OriginAddresses")
  destinationInventories Inventory[] @relation("DestinationAddresses")
  
  @@index([stateId])
  @@index([userId])
  @@index([isActive])
  @@index([zipCode])
}
