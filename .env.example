# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o-mini

# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mover_items?schema=public"

# AWS S3
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
# Optional CDN/CloudFront domain for public URLs:
S3_PUBLIC_URL_PREFIX=https://your-cdn-or-bucket-public-hostname

# Upstash Redis (optional; in-memory fallback will be used if absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP (Nodemailer) for emailing inventories
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Mover Inventory <no-reply@example.com>"

# Optional: absolute base URL for links in emails (fallbacks to request host)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
